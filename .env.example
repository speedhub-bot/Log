# ── Telegram credentials ────────────────────────────────────
BOT_TOKEN=               # From @BotFather
API_ID=                  # From my.telegram.org
API_HASH=                # From my.telegram.org
ADMIN_ID=                # Your Telegram numeric user ID
SESSION_STRING=          # Telethon user session string for large file downloads

# ── Processing ──────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2    # Max parallel extractions
FREE_DAILY_LIMIT_GB=2    # Free user daily quota in GB

# ── Paths ───────────────────────────────────────────────────
DATABASE_PATH=bot.db     # SQLite database path
LOG_FILE=bot.log         # Log file path
TEMP_DIR=/tmp/cookiebot  # Temp extraction directory
